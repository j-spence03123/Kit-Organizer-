{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kit Organizer",
  "version": "0.1.0",
  "identifier": "app.kitorganizer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kit Organizer",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "dragDropEnabled": true,
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost kitaudio: http://kitaudio.localhost; media-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Organise music production sample packs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
